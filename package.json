{
  "name": "ai-terminal",
  "version": "0.1.0",
  "description": "AI-Native Terminal Emulator with rich content rendering",
  "scripts": {
    "dev": "cargo tauri dev",
    "dev:renderer": "vite",
    "build": "npm run build:renderer && cargo tauri build",
    "build:renderer": "vite build",
    "start": "cargo tauri dev",
    "package": "cargo tauri build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:rust": "cargo test",
    "test:all": "npm run test && npm run test:rust && npm run test:e2e",
    "test:e2e": "playwright test",
    "test:e2e:server": "vite --config vite.e2e.config.ts"
  },
  "keywords": [
    "terminal",
    "ai",
    "tauri",
    "latex",
    "xterm",
    "rust"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-shell": "^2.3.5",
    "katex": "^0.16.47",
    "marked": "^12.0.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "shiki": "^1.29.2",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tauri-apps/cli": "^2.0.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.3.0",
    "@vitest/ui": "^2.1.9",
    "jsdom": "^24.1.3",
    "node-pty": "^1.1.0",
    "tsx": "^4.23.1",
    "typescript": "^5.4.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.9",
    "ws": "^8.21.1"
  }
}
