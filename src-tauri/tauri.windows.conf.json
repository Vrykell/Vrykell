{
  "app": {
    "windows": [
      {
        "title": "Vrykell",
        "width": 1240,
        "height": 800,
        "minWidth": 720,
        "minHeight": 480,
        "decorations": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "transparent": true,
        "backgroundColor": "#00000000"
      }
    ]
  },
  "bundle": {
    "targets": ["nsis"],
    "windows": { "nsis": {
      "installMode": "currentUser",
      "languages": ["English", "SimpChinese"],
      "installerHooks": "windows-context-menu/installer-hooks.nsh"
    } },
    "resources": {
      "windows-context-menu/generated/": "windows-context-menu/",
      "windows-context-menu/manage.ps1": "windows-context-menu/manage.ps1"
    }
  }
}
