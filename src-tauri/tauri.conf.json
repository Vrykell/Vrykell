{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vrykell",
  "version": "0.1.0",
  "identifier": "com.vrykell.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Vrykell",
        "width": 1240,
        "height": 800,
        "minWidth": 720,
        "minHeight": 480,
        "titleBarStyle": "Overlay",
        "trafficLightPosition": { "x": 16, "y": 19 },
        "hiddenTitle": true,
        "zoomHotkeysEnabled": false,
        "transparent": true,
        "backgroundColor": "#00000000"
      }
    ],
    "macOSPrivateApi": true,
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: http://asset.localhost; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost https://ipc.localhost ws://localhost:1420; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'",
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "license": "Apache-2.0",
    "licenseFile": "../LICENSE",
    "copyright": "Copyright 2026 Vrykell contributors",
    "resources": {
      "../LICENSE": "legal/LICENSE",
      "../NOTICE": "legal/NOTICE",
      "../public/legal/THIRD_PARTY_NOTICES.txt": "legal/THIRD_PARTY_NOTICES.txt",
      "../public/fonts/*-OFL.txt": "legal/fonts/"
    },
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
